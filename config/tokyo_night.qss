/* Tokyo Night Theme for AURA GCS */

/* Ana Pencere Arkaplani - Storm Background */
QMainWindow, QDialog, QDockWidget {
    background-color: #24283b;
    color: #a9b1d6;
}

/* Genel Widget Ayarlari */
QWidget {
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

/* Splitter (Ayirici) */
QSplitter::handle {
    background-color: #414868;
}

/* Dok Paneli Basligi */
QDockWidget::title {
    background: #1a1b26;
    color: #7aa2f7; /* Blue */
    padding-left: 10px;
    padding-top: 4px;
}

/* Grup Kutulari */
QGroupBox {
    border: 1px solid #414868;
    border-radius: 6px;
    margin-top: 12px;
    font-weight: bold;
    color: #bb9af7; /* Purple */
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
}

/* Etiketler */
QLabel {
    color: #c0caf5;
}

/* Butonlar - Genel */
QPushButton {
    background-color: #414868;
    color: #c0caf5;
    border: 1px solid #565f89;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #565f89;
    border-color: #7aa2f7;
}
QPushButton:pressed {
    background-color: #7aa2f7;
    color: #1a1b26;
}

/* Baglan Butonu (Default hali) */
QPushButton#ConnectBtn {
    background-color: #414868;
}

/* Baglantiyi Kes Butonu (Kirmizi) */
QPushButton#DisconnectBtn {
    background-color: #f7768e; /* Red */
    color: #1a1b26;
    border-color: #f7768e;
}
QPushButton#DisconnectBtn:hover {
    background-color: #db4b4b;
}

/* ComboBox */
QComboBox {
    background-color: #1a1b26;
    border: 1px solid #414868;
    border-radius: 4px;
    padding: 4px;
    color: #c0caf5;
}
QComboBox::drop-down {
    border: 0px;
}
QComboBox QAbstractItemView {
    background-color: #1a1b26;
    color: #c0caf5;
    selection-background-color: #7aa2f7;
    selection-color: #1a1b26;
}

/* ScrollBar */
QScrollBar:vertical {
    background: #1a1b26;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #414868;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}

/* Log Penceresi (TextEdit) */
QTextEdit {
    background-color: #1a1b26; /* Darker BG */
    color: #9ece6a; /* Green Text */
    border: 1px solid #414868;
    font-family: 'Consolas', 'Monospace';
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #414868;
}
QTabBar::tab {
    background: #24283b;
    color: #565f89;
    padding: 8px 16px;
    border: 1px solid #414868;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #1a1b26;
    color: #7aa2f7;
    border-bottom: 2px solid #7aa2f7;
}
/* Tab Widget Stili */
QTabWidget::pane {
    border: 1px solid #414868;
    background: #24283b;
}

QTabBar::tab {
    background: #1a1b26;
    color: #a9b1d6;
    padding: 10px 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #414868;
    color: #ffffff;
    border-bottom: 2px solid #7aa2f7;
}

QTabBar::tab:hover {
    background: #2f3549;
}

/* Parametre Listesi Form Layout */
QScrollArea {
    border: none;
    background-color: transparent;
}